<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.dam2.goya</groupId>
	<artifactId>adat-jpa3-tutorial</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
	<dependencies>
		<!-- evita los mensajes de info de SLF4J -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-nop</artifactId>
			<version>2.0.16</version>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
			<version>6.5.2.Final</version>
		</dependency>
		<dependency>
			<!-- No olvides cambiar esto si usas MySQL u otro gestor de
bases de datos -->
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
			<version>3.3.3</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.hibernate.tool</groupId>
				<artifactId>hibernate-tools-maven</artifactId>
				<version>6.5.2.Final</version>
				
				<executions>
					<execution>
						<id>generate-entities</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>hbm2java</goal>
						</goals>
					</execution>
				</executions>
				
				<configuration>
					<!-- En este directorio se dejaran las clases que se generen -->
					<outputDirectory>${project.basedir}/src/main/java</outputDirectory>
					<!-- Y el paquete se llamará así: -->
					<packageName>model</packageName>
					<ejb3>true</ejb3>
					<jdk5>true</jdk5>
					<properties>
						<hibernate.connection.driver_class>
							org.mariadb.jdbc.Driver
						</hibernate.connection.driver_class>
						<!-- Datos de conexión a la base de datos -->
						<hibernate.connection.url>
							jdbc:mariadb://localhost:3306/naciones
						</hibernate.connection.url>
						<hibernate.connection.username>perroflauta</hibernate.connection.username>
						<hibernate.connection.password>abc123</hibernate.connection.password>
						<hibernate.dialect>org.hibernate.dialect.MariaDBDialect</hibernate.dialect>
						<hibernate.default_catalog>naciones</hibernate.default_catalog>
						<hibernate.default_schema>naciones</hibernate.default_schema>
					</properties>
				</configuration>
				<dependencies>
					<dependency>
						<!-- No olvides cambiar esto si usas MySQL u otro gestor
						de bases de datos -->
						<groupId>org.mariadb.jdbc</groupId>
						<artifactId>mariadb-java-client</artifactId>
						<version>3.3.3</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>
</project>